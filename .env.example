# Copy to .env.local for local dev. In production set these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# --- Auth (Google) ---
# openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails allowed to sign in. Everyone else is refused.
ALLOWED_EMAILS=you@gmail.com

# --- Database (Neon / Vercel Postgres) ---
DATABASE_URL=

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Mortgage details (property address prefill) via Plaid Liabilities. Free in Sandbox and on Plaid's Trial plan;
# on a paid plan it's a monthly per-Item fee, charged only on Items that hold a mortgage. Set to "off" to disable.
PLAID_LIABILITIES=on

# --- Home value estimates (RentCast, rentcast.io → API dashboard). Free tier: 50 requests/month. ---
# Optional: without it, homes are valued by hand.
RENTCAST_API_KEY=

# --- Vercel Cron: monthly home revaluation. openssl rand -base64 32 ---
CRON_SECRET=

# --- Encryption for Plaid access tokens at rest ---
# openssl rand -base64 32   (must decode to exactly 32 bytes)
ENCRYPTION_KEY=
